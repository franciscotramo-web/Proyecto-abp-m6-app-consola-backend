<div id="view-perfil">
    <header class="py-4">
        <div class="container">
            <p class="text-primary fw-semibold mb-1">Vista detallada</p>
            <h1 class="h3 fw-bold mb-0">Perfil de usuario</h1>
        </div>
    </header>

    <main class="container pb-5">
        {{#if usuario }}
        <section class="card profile-card p-4 p-lg-5">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.25rem; font-weight: 700;">
                    {{usuario.nombre.[0]}}{{usuario.apellido.[0]}}
                </div>
                <div>
                    <h2 class="h4 mb-1">{{usuario.nombre}} {{usuario.apellido}}</h2>
                    <span class="badge bg-primary-subtle text-primary">Usuario activo</span>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <p class="text-muted mb-1">Nombre</p>
                        <p class="fw-semibold mb-0">{{usuario.nombre}}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3">
                        <p class="text-muted mb-1">Apellido</p>
                        <p class="fw-semibold mb-0">{{usuario.apellido}}</p>
                    </div>
                </div>
                <div class="col-12">
                    <div class="border rounded p-3">
                        <p class="text-muted mb-1">Correo</p>
                        <p class="fw-semibold mb-0">{{usuario.correo}}</p>
                    </div>
                </div>
            </div>
        </section>
        {{else}}
        <section class="card profile-card p-4 text-center">
            <p class="fs-4 fw-bold mb-2">No existe ningún usuario con el id: {{id}}</p>
            <p class="text-muted mb-0">Intenta volver a la lista de usuarios o crear uno nuevo.</p>
        </section>
        {{/if}}
    </main>
</div>