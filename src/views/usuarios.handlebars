<div id="view-usuarios">
    <header class="py-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <p class="text-primary fw-semibold mb-1">Vista de usuarios</p>
                    <h1 class="h3 fw-bold mb-0">Listado de usuarios</h1>
                </div>
                <a class="btn btn-brand" href="/crear-usuarios">Agregar usuario</a>
            </div>
        </div>
    </header>

    <main class="container pb-5">
        <section class="card table-card p-4">
            <div class="alert d-none" id="feedback-message" role="alert"></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Apellido</th>
                            <th scope="col">Correo</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each usuarios}}
                        <tr>
                            <th scope="row" class="text-muted">{{id}}</th>
                            <td>{{nombre}}</td>
                            <td>{{apellido}}</td>
                            <td>{{correo}}</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-primary btn-sm" href="/usuarios/perfil/{{id}}">Ver</a>
                                    <button class="btn btn-warning btn-sm btn-edit" type="button" data-id="{{id}}" data-nombre="{{nombre}}" data-apellido="{{apellido}}" data-correo="{{correo}}">Editar</button>
                                    <button class="btn btn-danger btn-sm btn-delete" type="button" data-id="{{id}}" data-nombre="{{nombre}}">Eliminar</button>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Aún no hay usuarios registrados.</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="edit-user-form">
                <div class="modal-body">
                    <input type="hidden" id="edit-user-id">
                    <div class="mb-3">
                        <label for="edit-nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="edit-nombre" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit-apellido" class="form-label">Apellido</label>
                        <input type="text" class="form-control" id="edit-apellido" required>
                    </div>
                    <div class="mb-3">
                        <label for="edit-correo" class="form-label">Correo</label>
                        <input type="email" class="form-control" id="edit-correo" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar edición</button>
                    <button type="submit" class="btn btn-brand">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const feedbackMessage = document.getElementById("feedback-message");
        const editModalElement = document.getElementById("editModal");
        const editModal = new bootstrap.Modal(editModalElement);
        const editUserForm = document.getElementById("edit-user-form");
        const editUserId = document.getElementById("edit-user-id");
        const editNombre = document.getElementById("edit-nombre");
        const editApellido = document.getElementById("edit-apellido");
        const editCorreo = document.getElementById("edit-correo");

        const showFeedback = (message, type = "success") => {
            feedbackMessage.className = `alert alert-${type}`;
            feedbackMessage.textContent = message;
            feedbackMessage.classList.remove("d-none");
        };

        document.querySelectorAll(".btn-edit").forEach((button) => {
            button.addEventListener("click", () => {
                editUserId.value = button.dataset.id;
                editNombre.value = button.dataset.nombre || "";
                editApellido.value = button.dataset.apellido || "";
                editCorreo.value = button.dataset.correo || "";
                editModal.show();
            });
        });

        editUserForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            const payload = {
                nombre: editNombre.value.trim(),
                apellido: editApellido.value.trim(),
                correo: editCorreo.value.trim()
            };

            try {
                const response = await fetch(`/api/usuarios/${editUserId.value}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (response.ok) {
                    editModal.hide();
                    showFeedback(data.message || "Usuario actualizado correctamente.");
                    setTimeout(() => window.location.reload(), 900);
                } else {
                    showFeedback(data.message || "No se pudo actualizar el usuario.", "danger");
                }
            } catch (error) {
                console.error(error);
                showFeedback("Ocurrió un error al actualizar el usuario.", "danger");
            }
        });

        document.querySelectorAll(".btn-delete").forEach((button) => {
            button.addEventListener("click", async () => {
                const nombreCompleto = `${button.dataset.nombre}`.trim();
                const confirmar = window.confirm(`¿Seguro que deseas eliminar a ${nombreCompleto || "este usuario"}?`);

                if (!confirmar) {
                    return;
                }

                try {
                    const response = await fetch(`/api/usuarios/${button.dataset.id}`, {
                        method: "DELETE"
                    });

                    const data = await response.json();

                    if (response.ok) {
                        showFeedback(data.message || "Usuario eliminado correctamente.");
                        setTimeout(() => window.location.reload(), 900);
                    } else {
                        showFeedback(data.message || "No se pudo eliminar el usuario.", "danger");
                    }
                } catch (error) {
                    console.error(error);
                    showFeedback("Ocurrió un error al eliminar el usuario.", "danger");
                }
            });
        });
    });
</script>