<div id="view-crear-usuario">
    <header class="py-4">
        <div class="container">
            <p class="text-primary fw-semibold mb-1">Registro nuevo</p>
            <h1 class="h3 fw-bold mb-0">Crear nuevos usuarios</h1>
        </div>
    </header>

    <main class="container pb-5">
        <section class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card form-card p-4 p-lg-5">
                    <form action="/api/usuarios" method="post" id="form-create-usuario" class="my-2">
                        <div class="mb-3">
                            <label for="nombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" name="nombre" id="nombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="apellido" class="form-label">Apellido</label>
                            <input type="text" class="form-control" name="apellido" id="apellido" required>
                        </div>
                        <div class="mb-3">
                            <label for="correo" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" name="correo" id="correo" required>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-brand">Crear usuario</button>
                            <button type="reset" class="btn btn-outline-secondary">Limpiar</button>
                        </div>
                    </form>
                    <div class="alert alert-success d-none mt-3" role="alert" id="alert-success"></div>
                </div>
            </div>
        </section>
    </main>
</div>

<script>
    const formCreateUsuario = document.getElementById("form-create-usuario");

    formCreateUsuario.addEventListener("submit", async (event) => {
        try {
            event.preventDefault();

            const nombre = document.getElementById("nombre");
            const apellido = document.getElementById("apellido");
            const correo = document.getElementById("correo");

            const myHeaders = new Headers();
            myHeaders.append("Content-Type", "application/json");

            const raw = JSON.stringify({
                nombre: nombre.value,
                apellido: apellido.value,
                correo: correo.value
            });

            const requestOptions = {
                method: "POST",
                headers: myHeaders,
                body: raw,
                redirect: "follow"
            };

            const response = await fetch("/api/usuarios", requestOptions);
            const data = await response.json();

            if (response.status === 201) {
                const alertSuccess = document.getElementById("alert-success");
                alertSuccess.textContent = data.message;
                alertSuccess.classList.remove("d-none");

                formCreateUsuario.reset();

                const { usuario } = data;
                setTimeout(() => {
                    location.href = "/usuarios/perfil/" + usuario.id;
                }, 1800);
            } else {
                alert(data.message || "No se pudo crear el usuario");
            }
        } catch (error) {
            console.error(error);
            alert("Error al intentar crear el usuario");
        }
    });
</script>